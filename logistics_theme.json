{
  "name": "Logistics Control Tower",
  "dataColors": ["#00B074", "#EBCB75", "#7F9FCE", "#9FCAC4", "#F0643C", "#B3B3B3", "#4A6FB5", "#F4A342"],
  "background": "#FFFFFF",
  "foreground": "#333333",
  "tableAccent": "#00B074",
  "good": "#00B074",
  "neutral": "#EBCB75",
  "bad": "#F0643C",
  "maximum": "#00B074",
  "center": "#EBCB75",
  "minimum": "#F0643C",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Light", "fontSize": 11, "color": "#A6A6A6" },
    "header": { "fontFace": "Segoe UI Light", "fontSize": 12, "color": "#333333" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#666666" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#252423" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F3F3" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "fontColor": { "solid": { "color": "#A6A6A6" } }, "fontFamily": "Segoe UI Light", "fontSize": 11 }],
        "visualHeader": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#252423" } }, "fontSize": 28 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#666666" } }, "fontSize": 9 }]
      }
    },
    "donutChart": {
      "*": { "slices": [{ "innerRadiusRatio": 75 }] }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#F3F3F3" } } }],
        "items": [{ "fontColor": { "solid": { "color": "#8C8C8C" } }, "background": { "solid": { "color": "#EDEDED" } } }]
      }
    }
  }
}
